# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log
logs/

backend/.venv

# ---------- Загруженные файлы (bind-mount на хост) ----------
uploads/*
# Сам каталог держим в репозитории: если его нет, Docker создаст точку
# bind-mount от root, и процесс в контейнере (appuser, uid 1000) не сможет
# писать — любая загрузка падает с PermissionError.
!uploads/.gitkeep

# Архивы с исходниками сайта — распакованная версия лежит в frontend/site
*.rar
*.zip
