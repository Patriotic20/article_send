# Пример переменных окружения. Скопировать в .env и заполнить:
#   cp .env.example .env

# --- Порты и публикация ---------------------------------------------------
# Интерфейс, на котором Docker публикует порты.
#   дев     — не задавать (0.0.0.0, удобно для отладки с других машин);
#   сервер  — 127.0.0.1, чтобы наружу смотрел только nginx.
# BIND_ADDR=127.0.0.1

DB_PORT=5433
BACKEND_PORT=8000
# Порт, на который проксирует хостовый nginx (см. deploy/nginx/*.conf).
FRONTEND_PORT=8080

# --- База данных ----------------------------------------------------------
POSTGRES_USER=article
POSTGRES_PASSWORD=change-me
POSTGRES_DB=article_send
DATABASE_URL=postgresql+asyncpg://article:change-me@db:5432/article_send

# --- Приложение -----------------------------------------------------------
# Origin, с которого открывается фронт. На сервере — https://idz.nsumt.uz.
CORS_ORIGINS=http://localhost:8080

# Обязательно заменить на длинную случайную строку: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Учётка администратора, создаётся при первом запуске.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
