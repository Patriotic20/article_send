# Скопируйте в .env при необходимости переопределить значения.

# Учётные данные Postgres (используются docker-compose.yml).
POSTGRES_USER=article
POSTGRES_PASSWORD=article
POSTGRES_DB=article_send

# Строка подключения приложения (async-драйвер asyncpg).
DATABASE_URL=postgresql+asyncpg://article:article@localhost:5433/article_send

# Разрешённые источники для CORS (через запятую).
CORS_ORIGINS=http://localhost:5173
